# ===== CLAVES / SECRETS (variables de entorno) =====
# Los parametros operativos (PAPER_MODE, RSI, SYMBOLS, montos, etc.)
# se editan desde el panel admin (tabla Supabase "bot_settings"),
# NO viven aqui.

# --- Supabase ---
# URL del proyecto: Project Dashboard > Project Settings > API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# anon public key (solo lectura publica / uso en cliente)
SUPABASE_ANON_KEY=TU_ANON_KEY
# service_role key (privileged: lectura+escritura, SOLO serverless/funciones)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Bitso (ccxt) ---
# Las llamadas publicas (OHLCV/tickers) NO requieren credenciales.
# Solo envia BITSO_API_KEY + BITSO_SECRET si quieres que el bot
# ejecute ordenes REALES (PAPER_MODE=false).
BITSO_API_KEY=
BITSO_SECRET=

# --- Admin panel ---
# Token que protege POST/PUT en /api/settings (igual al que usas en el panel).
ADMIN_TOKEN=cambia-este-token