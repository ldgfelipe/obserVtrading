# ===== Supabase =====
# URL del proyecto (Console > Project Settings > API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# anon public key (solo lectura / cliente)
SUPABASE_ANON_KEY=TU_ANON_KEY
# service_role key (privileged, SOLO server-side / serverless functions)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ===== Bitso (ccxt) =====
# Las llamadas publicas (OHLCV/tickers) NO requieren credenciales.
# Solo envia BITSO_API_KEY + BITSO_SECRET si quieres que el bot ejecute
# oordenes reales (trading REAL). Sin ellas opera solo observador/registro.
BITSO_API_KEY=
BITSO_SECRET=

# ===== Modo trading =====
# true  -> simula compras/ventas sobre un saldo virtual (recomendado)
# false -> si ademas hay BITSO keys, intenta ordenes reales
PAPER_MODE=true
PAPER_INITIAL_BALANCE_MXN=2000

# ===== Bot =====
# Par veces a vigilar (con / como separador); vacio = autodetecta todos de Bitso
SYMBOLS=BTC/MXN,ETH/MXN,SOL/MXN,XRP/MXN,LTC/MXN
INTERVAL_MINUTES=1440

# ===== Estrategia (mapeo de los valores del bot Python) =====
# Parámetros de entrada/salida basados en estrategia de compra en RSI
QUANT_STOP_LOSS_PCT=3.0
QUANT_TAKE_PROFIT_PCT=5.0
RSI_ENTRY=55
RSI_EXIT=45
MAX_AMOUNT_PER_TRADE_MXN=50
ADX_RANGE_THRESHOLD=25